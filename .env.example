# OpenAI API Configuration
# For local OpenAI-compatible API (e.g., LocalAI, Ollama, vLLM):
# Set OPENAI_API_BASE_URL to your local endpoint
# OPENAI_API_KEY can be empty for local APIs that don't require authentication

# Local API (recommended for privacy/offline use)
OPENAI_API_BASE_URL=http://localhost:8080/v1
OPENAI_API_KEY=

# OR Cloud OpenAI API
# OPENAI_API_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=your_openai_api_key_here

# Model Configuration (optional, defaults shown)
OPENAI_MODEL=gpt-4
WHISPER_MODEL=whisper-1

# Note: Copy this file to .env.local and configure your settings
# Never commit .env.local to version control
